# ===== Required =====
TELEGRAM_BOT_TOKEN=            # from @BotFather
MAX_USERS=55                   # how many people the circle holds; anyone with the bot or website link joins until it's full
ALLOWED_USER_IDS=              # optional: owners' Telegram ids (from @userinfobot). They always get in, even when full, and can use /circle

# ===== Database =====
DATABASE_URL=                  # Postgres URL. Empty = embedded PGlite in ./data (fine for one VPS).

# ===== Model (optional; rules-only without it). Set one or both keys. =====
ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5         # any Claude model id; cheap tier is enough for intent + chat
GEMINI_API_KEY=                # also unlocks Google-grounded scout lookups (founders/socials with citations)
GEMINI_MODEL=gemini-2.5-flash
MODEL_PROVIDER=                # anthropic | gemini | openai | empty = first key found (Anthropic, Gemini, then openai-compatible)
# Free/cheap OpenAI-compatible endpoints (Groq, OpenRouter, Cerebras, Mistral, Together) — or OpenAI itself:
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1     # OpenRouter: https://openrouter.ai/api/v1 · Cerebras: https://api.cerebras.ai/v1 · OpenAI: https://api.openai.com/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b                  # Groq retired the Llama 3.x models on 16 Aug 2026; leave empty for this default
OPENAI_COMPAT_FALLBACK_MODEL=openai/gpt-oss-20b          # tried when the first is rate-limited or missing
DAILY_MODEL_BUDGET_USD=0.5     # per user per day, enforced before the call
MODEL_PRICE_IN=1               # $/M input tokens, for the budget meter
MODEL_PRICE_OUT=5              # $/M output tokens

# ===== Web app + webhooks =====
PORT=3000                      # Railway injects PORT; keep this line for local
PUBLIC_URL=                    # the web app's public address: your Vercel domain if you use web/vercel.json, else the Railway domain. Needed for Twilio signature checks and secure cookies
WEB_URL=                       # the website people open, e.g. https://lifeline-web-one.vercel.app; the bot gives this address when someone asks how to use the web
WEB_ORIGINS=                   # leave empty when the Vercel front proxies /api and /auth (the default). Only set to https://your-web-domain if the front calls Railway directly
SESSION_SECRET=                # any long random string (openssl rand -hex 32)
WEBHOOK_SECRET=                # shared secret for the iMessage webhook (?secret=... or x-webhook-secret)

# ===== More ways to sign in on the website (optional; docs/SIGNIN.md) =====
# Codes by text, iMessage and email turn on by themselves once SMS, iMessage or email sending is set up.
GOOGLE_CLIENT_ID=              # Google OAuth web client id (...apps.googleusercontent.com); origins = the Vercel site and the Railway URL
APPLE_CLIENT_ID=               # Apple Services ID, e.g. com.yourname.lifeline.web (needs a paid Apple Developer account)
APPLE_REDIRECT_URI=            # optional: the Return URL on the Services ID; empty = the website's address with a trailing slash

# ===== The installable app: notifications (optional; docs/APP.md) =====
VAPID_PUBLIC_KEY=              # from `npx web-push generate-vapid-keys`; safe to show, the browser needs it
VAPID_PRIVATE_KEY=             # from the same command; secret, keep it forever (changing it means re-enabling every device)
VAPID_SUBJECT=                 # mailto:you@example.com, so push services can reach whoever runs lifeline

# ===== SMS (optional): an Android phone, or Twilio =====
# The cheap local way: a spare Android phone with a local SIM runs an SMS gateway app, and texts cost what that SIM charges.
#  1. On the phone, install httpSMS (httpsms.com, from the Play Store) and sign in.
#  2. In the httpSMS web dashboard, copy the API key into SMS_GATEWAY_API_KEY.
#  3. Still in the dashboard, add a webhook: URL $PUBLIC_URL/webhooks/sms/httpsms, event message.phone.received,
#     and a signing key you make up (openssl rand -hex 32). Put that same key in SMS_WEBHOOK_SECRET.
#  4. Set SMS_GATEWAY_FROM to the phone's own number in +234... form, and SMS_NUMBER to how you'd write it for a friend.
#  5. Redeploy. Friends text "link ABC123" (code from saying "link" on Telegram) to SMS_NUMBER. Full guide: docs/SMS.md
SMS_PROVIDER=                  # httpsms (default when a gateway key is set) | textbee | twilio
SMS_GATEWAY_API_KEY=           # from the httpSMS or TextBee dashboard
SMS_GATEWAY_FROM=              # httpsms: the gateway phone's number, +2348012345678. textbee: the device id
SMS_WEBHOOK_SECRET=            # the signing key (httpSMS) or webhook secret (TextBee) you set on the webhook
SMS_NUMBER=                    # the number people text, as written for humans: +234 801 234 5678
SMS_DEFAULT_COUNTRY_CODE=234   # local numbers like 0801... are read as this country

# Twilio instead (international numbers; texting a foreign number from Nigeria costs more)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                   # your Twilio number; point its "A message comes in" webhook at $PUBLIC_URL/webhooks/twilio

# ===== iMessage (optional; Apple has no API, pick a relay) =====
IMESSAGE_PROVIDER=             # bluebubbles | sendblue
IMESSAGE_ADDRESS=              # the phone number or Apple ID email people send iMessages to; shown in "link" replies
BLUEBUBBLES_URL=               # http(s)://<mac>:1234 — self-hosted on a Mac you own; set its webhook to $PUBLIC_URL/webhooks/imessage?secret=$WEBHOOK_SECRET
BLUEBUBBLES_PASSWORD=
SENDBLUE_API_KEY=              # hosted alternative, paid per message
SENDBLUE_API_SECRET=

# ===== Voice notes (optional) =====
OPENAI_API_KEY=                # transcription only
STT_MODEL=gpt-4o-mini-transcribe

# ===== Email fallback (optional, send-only) =====
SMTP_URL=                      # smtp://user:pass@smtp.example.com:587
EMAIL_FROM=lifeline@example.com

# ===== Defaults =====
DEFAULT_TZ=Africa/Lagos
QUIET_HOURS=22-07
MAX_PUSHES_PER_DAY=3           # proactive pushes; reminders and meds are exempt
DIGEST_HOUR=7

# ===== Hackathon sources =====
HACKATHONRADAR_API_KEY=        # https://www.hackathonradar.com/docs/api
HACKATHONRADAR_API_URL=        # override if their path differs
ENABLE_DEVPOST=true
ENABLE_SUPERTEAM=true
ENABLE_ETHGLOBAL=true
ENABLE_COLOSSEUM=true
ENABLE_HACKCLUB=false          # high-school events

# ===== Launch discovery =====
GITHUB_TOKEN=                  # optional; raises the search rate limit
GITHUB_TOPICS=ai-agents,defi,devtools,fintech,ethereum,solana

# ===== Prices / portfolio =====
# RPC_ETHEREUM= RPC_BASE= RPC_ARBITRUM= RPC_OPTIMISM= RPC_POLYGON= RPC_BSC= RPC_SOLANA=   (public defaults are used)
ETHERSCAN_API_KEY=             # optional; wallet activity alerts on EVM chains (free key at etherscan.io)

# ===== Safety =====
SAFE_BROWSING_KEY=             # optional; Google Safe Browsing check for links in "is this a scam"

# ===== Home and the world (all optional) =====
FOOTBALL_DATA_KEY=             # football fixtures and results from football-data.org (free tier)
THESPORTSDB_KEY=               # other sports; defaults to TheSportsDB's free key
AVIATIONSTACK_KEY=             # flight status (free tier: 100 requests a month)

# ===== Bill payments, Nigeria only (Tier 2) =====
FLUTTERWAVE_SECRET_KEY=        # needs KYC, funded balance, whitelisted server IP
FLUTTERWAVE_BASE=https://api.flutterwave.com/v3

# ===== Trading (shadow mode only; execution is not implemented on purpose) =====
ENABLE_POLYMARKET_SHADOW=false
ENABLE_PUMPFUN_SHADOW=false
PUMPPORTAL_API_KEY=

# ---- Voice, photos, drawing and search (docs/MEDIA.md). Hearing, speaking, seeing and search use the Groq/Gemini keys above. ----
CLOUDFLARE_ACCOUNT_ID=          # drawing pictures, free daily allowance
CLOUDFLARE_API_TOKEN=           # a token made from the "Workers AI" template
ENABLE_POLLINATIONS=true        # no-key fallback for drawing; slow
GEMINI_IMAGE_MODEL=             # only if your Gemini project has billing
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Sulafat

# ---- Email (docs/EMAIL.md) ----
# Sending: SMTP_URL and EMAIL_FROM above (Gmail app password works).
RESEND_API_KEY=                 # receiving: reads mail sent to your Resend address
RESEND_WEBHOOK_SECRET=          # whsec_..., from the email.received webhook
INBOUND_EMAIL=                  # e.g. lifeline@abc123.resend.app

# ---- iMessage extras (docs/IMESSAGE.md) ----
BLUEBUBBLES_METHOD=apple-script # or private-api if the helper is installed

# ===== Creative and NFTs (all optional) =====
OPENSEA_API_KEY=               # NFT floor prices on EVM chains (free key from OpenSea's developer portal)
MAGICEDEN_API_KEY=             # optional; Solana floors work without it at lower limits

# ===== Research =====
OPENAI_SEARCH_MODEL=           # optional; with OPENAI_API_KEY set, web search uses OpenAI's web_search tool on this model (default gpt-4.1-mini)
